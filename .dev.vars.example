# Copy to .dev.vars and fill in local-only values. Never commit .dev.vars.
# Local origin. The Vite dev server is pinned to port 8787.
APP_URL=http://localhost:8787
# Set only when the app is served from a proxy origin, e.g. https://chapterping.vercel.app.
# Must be the origin the browser actually sees: Discord's callback is built from it.
# PUBLIC_URL=
ENVIRONMENT=development

# Discord OAuth application (Developer Portal -> OAuth2).
# Redirect: http://localhost:8787/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# openssl rand -hex 32
BETTER_AUTH_SECRET=
# openssl rand -base64 32
WEBHOOK_ENCRYPTION_KEY=

# Discord webhook the operator is paged on when a cron run fails or stalls.
# Optional: unset means no alerts. In production set it with
#   wrangler secret put ALERT_WEBHOOK_URL
# ALERT_WEBHOOK_URL=

# Discord user ids that get the owner desk and skip every cap and rate limit.
# Comma-separated. Unset means nobody is an admin. In production set it with
#   wrangler secret put ADMIN_DISCORD_IDS
# ADMIN_DISCORD_IDS=

# Capacity defaults. Omit any line to use the built-in default.
MAX_ACCOUNTS=100
MAX_SERIES_PER_USER=5
MAX_DESTINATIONS_PER_USER=2
MAX_ACTIVE_SERIES=150
POLL_INTERVAL_MINUTES=30
CRON_BATCH_SERIES=20
CRON_BATCH_DELIVERIES=20
MAX_TEST_SENDS_PER_HOUR=5
