{
  "name": "chapter-ping",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A free, multi-series manga chapter alert service for Discord.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/clean-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "load-test": "node scripts/load-test.mjs",
    "docs": "node scripts/docs.mjs",
    "social-card": "node scripts/social-card.mjs",
    "setup:discord": "node scripts/set-discord.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply chapter-ping --local",
    "db:migrate:remote": "wrangler d1 migrations apply chapter-tracker-web --remote",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc --env production",
    "deploy:self": "npm run build && wrangler deploy --config wrangler.jsonc",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --config wrangler.jsonc --env production"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.2",
    "better-auth": "^1.3.26",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.2.5",
    "hono": "^4.9.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.10",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.0"
  }
}
